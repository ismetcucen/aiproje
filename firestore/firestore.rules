rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNotObserver() {
      // Nedim Usta (Observer / Read-Only Admin)
      return request.auth.uid != 'ck3lnkqqKWZVXiC4yYP7lOGgc8w2';
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isNotObserver();
    }
    match /school_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isNotObserver();
    }
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isNotObserver();
    }
  }
}
